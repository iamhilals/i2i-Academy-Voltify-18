# ============================================================================
# VoltWise / Voltify - Yerel Geliştirme Ortam Değişkenleri ŞABLONU
# ----------------------------------------------------------------------------
# Bu dosyayı aynı klasöre 'application-local.properties' adıyla KOPYALAYIN ve
# kendi gizli değerlerinizi girin. Gerçek anahtarları içeren
# application-local.properties dosyası .gitignore ile takip dışıdır ve ASLA
# commit EDİLMEZ (Şartname 5.2.2 / 5.7.2 - hiçbir gizli anahtar hardcode edilmez).
#
# Alternatif: Bu değerleri işletim sistemi ortam değişkeni olarak da
# tanımlayabilirsiniz; application.properties zaten ${GEMINI_API_KEY:} gibi
# placeholder'larla bu değişkenleri okur. Değer verilmezse uygulama güvenli
# varsayılanlarla çalışmaya devam eder (AI ve e-posta temiz fallback yapar).
# ============================================================================

# Google Gemini API anahtarı (yoksa AI, temiz bir fallback metni döndürür)
GEMINI_API_KEY=your_gemini_api_key_here

# Gmail SMTP (uyarı e-postaları için; yoksa e-posta gönderimi atlanır)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# JWT imzalama anahtarı (en az 32 karakter). Üretimde MUTLAKA değiştirin.
JWT_SECRET=voltify-super-secret-key-must-be-at-least-32-characters-long
